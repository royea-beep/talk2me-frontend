# TALK2ME frontend — single-user dashboard, iteration 1
# Copy to .env.local and fill in real values. Never commit .env.local.
#
# SUPABASE_URL is public infrastructure.
# ANON_KEY is the transport key; RLS blocks all SELECT from anon, so it
# can't read tables directly. All data comes via frontend_dashboard_data EF.
# Service role key is NEVER stored here. It lives in EF env on Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# X-Empire-Secret guard for frontend_dashboard_data EF (Path B — opaque shared secret).
# 32-byte hex from `openssl rand -hex 32`. Must match TALK2ME_DASHBOARD_SECRET in Supabase EF env.
# TODO(2026-Q3): migrate to Path A (Supabase Auth verify_jwt=true) and remove.
NEXT_PUBLIC_DASHBOARD_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET
